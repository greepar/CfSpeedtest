<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\CfSpeedtest.Shared\CfSpeedtest.Shared.csproj" />
    <PackageReference Include="StuDev.AotAnywhere" Version="1.0.5" PrivateAssets="all" Condition="'$(UseAotAnywhere)' == 'true'" />
    <PackageReference Include="Vezel.Zig.Toolsets.$(NETCoreSdkPortableRuntimeIdentifier)" Version="0.16.0.2" PrivateAssets="all" GeneratePathProperty="true" IsImplicitlyDefined="true" Condition="'$(UseAotAnywhere)' == 'true'" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishAot>true</PublishAot>
    <SelfContained>false</SelfContained>
    <SelfContained Condition="'$(PublishAot)' == 'true'">true</SelfContained>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <Version>2.1.12</Version>
    <AssemblyVersion>2.1.12.0</AssemblyVersion>
    <FileVersion>2.1.12.0</FileVersion>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UseAotAnywhere)' == 'true'">
    <NoWarn>$(NoWarn);NETSDK1023</NoWarn>
  </PropertyGroup>

  <!-- WebUI 资源编译进程序集。发布单文件时不依赖 wwwroot 或 staticwebassets 清单。 -->
  <ItemGroup>
    <Content Remove="wwwroot\**" />
    <None Remove="wwwroot\**" />
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <Content Update="web.config" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- 构建 Server 前自动运行前端构建（npm/node 不可用时跳过，不阻断编译） -->
  <Target Name="BuildWebUi" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="npm run build" WorkingDirectory="..\CfSpeedtest.Web" ContinueOnError="true" IgnoreExitCode="true" Condition="'$(SkipBuildWebUi)' != 'true'" />
    <ItemGroup>
      <EmbeddedResource Include="wwwroot\**\*" />
      <EmbeddedResource Update="wwwroot\**\*" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

</Project>
